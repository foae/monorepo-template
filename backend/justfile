# Build all services.
build-all:
    go build ./...

# Run all tests with race detection.
test-all:
    go test -race -v ./...

# Run go vet on everything.
vet-all:
    go vet ./...

# Run go fmt on everything.
fmt-all:
    go fmt ./...

# Run go mod tidy.
tidy:
    go mod tidy

# Run the same repository verification gate as CI.
check-all:
    just --justfile "{{source_directory()}}/../justfile" check

# Clean all build artifacts.
clean-all:
    rm -rf bin/
