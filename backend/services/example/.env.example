# Required
POSTGRES_URL=postgres://postgres:postgres@localhost:5432/example?sslmode=disable

# Optional — defaults shown
SERVICE_NAME=example
SERVICE_VERSION=v1.0.0
ENV_MODE=dev
HTTP_LISTEN_ADDR=0.0.0.0:8080
SERVICE_REGION=local
WORKER_INTERVAL=1h
GRACEFUL_SHUTDOWN_TIMEOUT=90s
HTTP_DRAIN_DELAY=5s

# OpenTelemetry: disabled unless host:port is set (not a URL)
OTEL_TRACING_ENDPOINT=
OTEL_TRACING_SAMPLE_RATIO=0.1
# TLS is default; true only for a trusted plaintext collector
OTEL_TRACING_INSECURE=false

# DNS pinning override (optional, for K8s per-DC overrides)
# POSTGRES_URL_HOST=postgres.example.svc.cluster.local
