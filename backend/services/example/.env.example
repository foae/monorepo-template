# Required
POSTGRES_URL=postgres://postgres:postgres@localhost:5432/example?sslmode=disable

# Optional — defaults shown
SERVICE_NAME=example
SERVICE_VERSION=v1.0.0
ENV_MODE=dev
HTTP_LISTEN_ADDR=0.0.0.0:8080
SERVICE_REGION=local
WORKER_INTERVAL=1h
GRACEFUL_SHUTDOWN_TIMEOUT=90s

# OpenTelemetry (leave empty to skip)
OTEL_TRACING_ENDPOINT=

# DNS pinning override (optional, for K8s per-DC overrides)
# POSTGRES_URL_HOST=custom-hostname.internal
